<launch>
  <arg name="slam" default="false"/>
  <arg name="map" default="$(find br2_navigation)/maps/aws_house.yaml"/>
  <arg name="rviz" default="false"/>

  <!-- Map server (when not using SLAM) -->
  <group unless="$(arg slam)">
    <node pkg="map_server" type="map_server" name="map_server" args="$(arg map)" output="screen">
      <param name="use_sim_time" value="true"/>
    </node>

    <!-- AMCL for localization -->
    <node pkg="amcl" type="amcl" name="amcl" output="screen">
      <param name="use_sim_time" value="true"/>
      <param name="alpha1" value="0.2"/>
      <param name="alpha2" value="0.2"/>
      <param name="alpha3" value="0.2"/>
      <param name="alpha4" value="0.2"/>
      <param name="base_frame_id" value="base_footprint"/>
      <param name="global_frame_id" value="map"/>
      <param name="odom_frame_id" value="odom"/>
      <param name="beam_skip_distance" value="0.5"/>
      <param name="beam_skip_error_threshold" value="0.9"/>
      <param name="beam_skip_threshold" value="0.3"/>
      <param name="do_beamskip" value="false"/>
      <param name="lambda_short" value="0.1"/>
      <param name="laser_likelihood_max_dist" value="2.0"/>
      <param name="laser_max_range" value="100.0"/>
      <param name="laser_min_range" value="-1.0"/>
      <param name="laser_model_type" value="likelihood_field"/>
      <param name="max_beams" value="60"/>
      <param name="max_particles" value="2000"/>
      <param name="min_particles" value="500"/>
      <param name="odom_model_type" value="diff"/>
      <param name="pf_err" value="0.05"/>
      <param name="pf_z" value="0.99"/>
      <param name="recovery_alpha_fast" value="0.0"/>
      <param name="recovery_alpha_slow" value="0.0"/>
      <param name="resample_interval" value="1"/>
      <param name="save_pose_rate" value="0.5"/>
      <param name="sigma_hit" value="0.2"/>
      <param name="tf_broadcast" value="true"/>
      <param name="transform_tolerance" value="1.0"/>
      <param name="update_min_a" value="0.2"/>
      <param name="update_min_d" value="0.25"/>
      <param name="z_hit" value="0.5"/>
      <param name="z_max" value="0.05"/>
      <param name="z_rand" value="0.5"/>
      <param name="z_short" value="0.05"/>
      <param name="initial_pose_x" value="0.0"/>
      <param name="initial_pose_y" value="0.0"/>
      <param name="initial_pose_a" value="0.0"/>
      <remap from="scan" to="/scan_raw"/>
    </node>
  </group>

  <!-- SLAM Toolbox (when using SLAM) -->
  <group if="$(arg slam)">
    <node pkg="slam_toolbox" type="async_slam_toolbox_node" name="slam_toolbox" output="screen">
      <rosparam file="$(find br2_navigation)/params/mapper_params_online_async.yaml" command="load"/>
      <param name="use_sim_time" value="true"/>
    </node>
  </group>

  <!-- move_base navigation -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <rosparam file="$(find br2_navigation)/params/tiago_nav_params.yaml" command="load"/>
    <remap from="cmd_vel" to="/mobile_base_controller/cmd_vel"/>
    <remap from="odom" to="/mobile_base_controller/odom"/>
  </node>

  <!-- RViz -->
  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="rviz" output="screen"/>
  </group>
</launch>
